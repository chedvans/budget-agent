# העתיקו קובץ זה לקובץ בשם .env ומלאו את הפרטים. הקובץ .env לא עולה ל-GitHub.
# את המפתח יוצרים ב-Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=הכניסו-כאן-את-המפתח

# שם המודל. אם מתקבלת שגיאה שהמודל לא נמצא, העתיקו שם מודל מהרשימה ב-AI Studio
GEMINI_MODEL=gemini-3.5-flash-lite
